# ============================================================
# TechNexus — Variáveis de Ambiente
# ============================================================
# Copia este ficheiro para .env e preenche os valores reais.
# NUNCA coloques este ficheiro .env no repositório.
# ============================================================

# ----------------------------------------------------------
# Configuração Flask
# ----------------------------------------------------------
FLASK_ENV=development
# Em produção: production
# Em desenvolvimento: development

FLASK_DEBUG=1
# Em produção: 0

SECRET_KEY=SUBSTITUI_POR_UMA_CHAVE_SECRETA_LONGA_E_ALEATORIA
# Gera com: python -c "import secrets; print(secrets.token_hex(32))"

# ----------------------------------------------------------
# Base de dados — PostgreSQL via Supabase
# ----------------------------------------------------------
DATABASE_URL=postgresql://usuario:palavra_passe@host:5432/nome_base_dados
# Exemplo Supabase: postgresql://postgres:senha@db.xxxxxxxxxxx.supabase.co:5432/postgres

# Sessão de base de dados (pool)
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ----------------------------------------------------------
# Inteligência Artificial — Google Gemini API
# ----------------------------------------------------------
GEMINI_API_KEY=A_TUA_CHAVE_GEMINI_API_AQUI
# Obtém em: https://aistudio.google.com/app/apikey

GEMINI_MODEL=gemini-2.0-flash
# Modelos disponíveis: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash

GEMINI_MAX_TOKENS=2048
# Máximo de tokens por resposta do assistente

GEMINI_TEMPERATURE=0.3
# Criatividade das respostas (0.0 = determinístico, 1.0 = criativo)

GEMINI_ENABLED=true
# false = desativa o assistente IA (o resto do sistema continua a funcionar)

GEMINI_DAILY_LIMIT=100
# Limite de pedidos por dia (para controlo de custos)

# ----------------------------------------------------------
# Aplicação
# ----------------------------------------------------------
APP_NAME=TechNexus
APP_BASE_URL=http://localhost:5000
# Em produção: https://o-teu-dominio.com

APP_CURRENCY=MZN
APP_CURRENCY_SYMBOL=MT
APP_LOCALE=pt_MZ
APP_TIMEZONE=Africa/Maputo

# ----------------------------------------------------------
# Segurança — Sessões
# ----------------------------------------------------------
SESSION_COOKIE_SECURE=false
# Em produção: true (requer HTTPS)

SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400
# Duração da sessão em segundos (86400 = 24 horas)

# ----------------------------------------------------------
# Limite de tentativas de autenticação
# ----------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ----------------------------------------------------------
# Ficheiros e uploads
# ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,xlsx,csv

# ----------------------------------------------------------
# Notificações por e-mail (opcional — para recuperação de senha)
# ----------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@technexus.co.mz
MAIL_ENABLED=false

# ----------------------------------------------------------
# Backups
# ----------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------
# Logs
# ----------------------------------------------------------
LOG_LEVEL=INFO
# Em produção: WARNING ou ERROR
LOG_FILE=logs/technexus.log
